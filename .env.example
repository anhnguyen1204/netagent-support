# LLM backend: null | ollama | netmind
LLM_BACKEND=null

# Ollama (used when LLM_BACKEND=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# netMind gateway (used when LLM_BACKEND=netmind, fill in if access granted)
NETMIND_API_URL=
NETMIND_API_KEY=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=netagent_kb

# Embedding model (bge-m3 preferred, falls back to paraphrase-multilingual-mpnet-base-v2)
EMBEDDING_MODEL=BAAI/bge-m3

# Alerting: console | email
ALERTER_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Server
HOST=0.0.0.0
PORT=8000
