# Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment / secrets
.env

# Generated / intermediate data (regenerated by scripts/build_kb.py)
data/processed/

# Raw dataset — kept OUT of the repo (contains real usernames, IPs, internal URLs).
# Provide your own data/raw/output.csv to run the pipeline.
data/raw/

# Golden set — sampled from the raw chat, so it carries the same real usernames/content.
# Kept private for the same reason as the raw dataset.
data/golden_set.csv
data/golden_set.xlsx

# Golden Q&A eval set — kept private alongside golden_set.csv (same eval-integrity
# rationale: don't want it tuned-to by anyone outside the project).
data/qa_golden.csv

# Local editor / tooling settings (not part of the project)
.claude/

# Build artifacts (regenerable)
*.pdf

# OS
.DS_Store
*.docx
